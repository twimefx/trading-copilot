# Copy to .env and fill in. NEVER commit the real .env.

# --- LLM / data providers ---
ANTHROPIC_API_KEY=
HF_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=postgresql://copilot:***@localhost:5432/trading_copilot
BINANCE_API_KEY=
BINANCE_API_SECRET=
OANDA_API_TOKEN=
OANDA_ENV=practice

# --- Auth (Clerk) ---
# Backend verifies the Clerk session JWT against this JWKS endpoint.
# Find these in the Clerk dashboard -> API Keys / Frontend API.
CLERK_JWKS_URL=https://<your-slug>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-slug>.clerk.accounts.dev
# Optional hardening: comma-separated allowed azp (frontend origins).
CLERK_AUTHORIZED_PARTIES=
# Dev only: set to 1 to accept a legacy X-Owner-Id header when no JWT is present.
# MUST be 0/unset in production.
AUTH_DEV_ALLOW_HEADER=0

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
# Stripe Price IDs for each paid tier (create recurring prices in Stripe first).
STRIPE_PRICE_PRO=price_***
STRIPE_PRICE_PREMIUM=price_***
# Where Stripe returns the user after checkout / from the billing portal.
BILLING_SUCCESS_URL=https://trading-copilot-opal.vercel.app/?upgraded=1
BILLING_CANCEL_URL=https://trading-copilot-opal.vercel.app/?upgrade=cancelled
BILLING_PORTAL_RETURN_URL=https://trading-copilot-opal.vercel.app/

# --- Tier tuning (optional; sensible defaults in backend/billing/__init__.py) ---
# FREE_DAILY_COPILOT_QUOTA=3
# PRO_DAILY_COPILOT_QUOTA=100
# PREMIUM_DAILY_COPILOT_QUOTA=-1      # -1 = unlimited
# PRO_PRICE_USD=49
# PREMIUM_PRICE_USD=199

# --- Frontend (Vercel) — NOT read by the backend, listed for reference ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_***
# CLERK_SECRET_KEY=sk_live_***       # server-side Clerk (Next middleware)
# BACKEND_URL=https://trading-copilot-production-454e.up.railway.app
